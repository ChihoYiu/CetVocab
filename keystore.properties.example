# 复制成 keystore.properties 并填入你自己的值。**这个文件绝不会被提交**（见 .gitignore）。
#
# 生成密钥库（只需做一次，请妥善备份，丢失后无法给已发布的应用签名更新）：
#   keytool -genkeypair -v -keystore cetvocab-release.jks -alias cetvocab \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# 路径可以写相对仓库根目录的相对路径，也可以写绝对路径。
storeFile=cetvocab-release.jks
storePassword=在这里填密钥库口令
keyAlias=cetvocab
keyPassword=在这里填密钥口令
