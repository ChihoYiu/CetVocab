# 统一换行符，避免 Windows 与 macOS/Linux 之间产生整文件 diff。
* text=auto

# 源码与文档一律以 LF 存库
*.kt    text eol=lf
*.kts   text eol=lf
*.java  text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.toml  text eol=lf
*.pro   text eol=lf

# 二进制与构建产物绝不参与文本转换
*.png   binary
*.jpg   binary
*.webp  binary
*.apk   binary
*.aab   binary
*.jar   binary
*.jks   binary
*.keystore binary

# 词库资产很大且是机器生成的，折叠其 diff 以免污染评审
app/src/main/assets/wordpacks/*.json linguist-generated=true
