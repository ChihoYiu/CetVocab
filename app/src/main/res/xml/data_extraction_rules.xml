<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer rules. Study progress, wrong-answer book and settings
     are small, user-owned and worth restoring; nothing else is exported. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
