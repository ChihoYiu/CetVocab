      "id": "tip-0124",
      "category": "时间与节奏",
      "text": "给自己留一点无用的时间，也是照顾。"
    },
    {
      "id": "tip-0125",
      "category": "时间与节奏",
      "text": "睡前十分钟，回顾今天记住的单词。"
    },
    {
      "id": "tip-0126",
      "category": "时间与节奏",
      "text": "别把一天排满，留点余地给意外。"
    },
    {
      "id": "tip-0127",
      "category": "时间与节奏",
      "text": "学习像呼吸，有进有出才有节奏。"
    },
    {
      "id": "tip-0128",
      "category": "时间与节奏",
      "text": "身体累了就停，硬撑反而记不住。"
    },
    {
      "id": "tip-0129",
      "category": "时间与节奏",
      "text": "间隔着复习，记忆会自己长出根来。"
    },
    {
      "id": "tip-0130",
      "category": "时间与节奏",
      "text": "把大目标摊到一学期，步子就轻了。"
    },
    {
      "id": "tip-0131",
      "category": "时间与节奏",
      "text": "早上先做一件小事，一天都好进入。"
    },
    {
      "id": "tip-0132",
      "category": "时间与节奏",
      "text": "适时地停下来，是为了走得更稳。"
    },
    {
      "id": "tip-0133",
      "category": "时间与节奏",
      "text": "把任务排开，别都堆在深夜。"
    },
    {
      "id": "tip-0134",
      "category": "时间与节奏",
      "text": "挑一个固定时段，只留给单词。"
    },
    {
      "id": "tip-0135",
      "category": "时间与节奏",
      "text": "给自己一点缓冲，别把日程排太满。"
    },
    {
      "id": "tip-0136",
      "category": "时间与节奏",
      "text": "短暂休息之后，注意力会重新聚拢。"
    },
    {
      "id": "tip-0137",
      "category": "时间与节奏",
      "text": "节奏乱掉也没关系，重新找回来就好。"
    },
    {
      "id": "tip-0138",
      "category": "时间与节奏",
      "text": "把今天分成几段，每段只专注一件事。"
    },
    {
      "id": "tip-0139",
      "category": "时间与节奏",
      "text": "运动半小时，回来读书更坐得住。"
    },
    {
      "id": "tip-0140",
      "category": "时间与节奏",
      "text": "事情做完再放松，休息才真的香。"
    },
    {
      "id": "tip-0141",
      "category": "时间与节奏",
      "text": "白天做完大半，夜里就能早点睡。"
    },
    {
      "id": "tip-0142",
      "category": "时间与节奏",
      "text": "给自己一个截止的时刻，然后收工。"
    },
    {
      "id": "tip-0143",
      "category": "时间与节奏",
      "text": "提前十分钟出门，路上就不用跑。"
    },
    {
      "id": "tip-0144",
      "category": "时间与节奏",
      "text": "让生活有张有弛，学习才走得远。"
    },
    {
      "id": "tip-0145",
      "category": "时间与节奏",
      "text": "换个地方学习，注意力会新鲜一点。"
    },
    {
      "id": "tip-0146",
      "category": "时间与节奏",
      "text": "把重要的事排前面，剩下的顺其自然。"
    },
    {
      "id": "tip-0147",
      "category": "时间与节奏",
      "text": "每天给手机也定个休息时间吧。"
    },
    {
      "id": "tip-0148",
      "category": "时间与节奏",
      "text": "在状态好的时候多做一些，状态差就少做。"
    },
    {
      "id": "tip-0149",
      "category": "时间与节奏",
      "text": "给每一天留个句号，明天才好重新开头。"
    },
    {
      "id": "tip-0150",
      "category": "时间与节奏",
      "text": "有空的时候就多读几页，别等到忙。"
    },
    {
      "id": "tip-0151",
      "category": "积累与复利",
      "text": "每记住一个词，都是往口袋里存一枚硬币。"
    },
    {
      "id": "tip-0152",
      "category": "积累与复利",
      "text": "今天多会一个词，未来就多一种表达。"
    },
    {
      "id": "tip-0153",
      "category": "积累与复利",
      "text": "单词不会白背，它们会在某天连成句子。"
    },
    {
      "id": "tip-0154",
      "category": "积累与复利",
      "text": "先认识这个词，再慢慢认识它的朋友。"
    },
    {
      "id": "tip-0155",
      "category": "积累与复利",
      "text": "读多了自然有感觉，语感是攒出来的。"
    },
    {
      "id": "tip-0156",
      "category": "积累与复利",
      "text": "背过的词会沉淀下来，成为你的底子。"
    },
    {
      "id": "tip-0157",
      "category": "积累与复利",
      "text": "一次记住一点，次数多了就成了记得。"
    },
    {
      "id": "tip-0158",
      "category": "积累与复利",
      "text": "小得看不见的进步，也在叠加。"
    },
    {
      "id": "tip-0159",
      "category": "积累与复利",
      "text": "每天前进一步，一学期就是很长的路。"
    },
    {
      "id": "tip-0160",
      "category": "积累与复利",
      "text": "复习不是重复劳动，是把记忆焊牢。"
    },
    {
      "id": "tip-0161",
      "category": "积累与复利",
      "text": "词汇量像雪球，滚着滚着就大了。"
    },
    {
      "id": "tip-0162",
      "category": "积累与复利",
      "text": "今天啃下的难词，明年就是老朋友。"
    },
    {
      "id": "tip-0163",
      "category": "积累与复利",
      "text": "一点点的积累，会在某天显出分量。"
    },
    {
      "id": "tip-0164",
      "category": "积累与复利",
      "text": "同一个词见三次，它就开始属于你。"
    },
    {
      "id": "tip-0165",
      "category": "积累与复利",
      "text": "书读百遍，意思会自己浮上来。"
    },
    {
      "id": "tip-0166",
      "category": "积累与复利",
      "text": "把新词和老词连起来，记忆就成网了。"
    },
    {
      "id": "tip-0167",
      "category": "积累与复利",
      "text": "慢慢积累的人，走得比想象中远。"
    },
    {
      "id": "tip-0168",
      "category": "积累与复利",
      "text": "每次复习都在给记忆加一层。"
    },
    {
      "id": "tip-0169",
      "category": "积累与复利",
      "text": "刚开始总是慢的，后面会越来越顺。"
    },
    {
      "id": "tip-0170",
      "category": "积累与复利",
      "text": "存下来的词，总有一天会派上用场。"
    },
    {
      "id": "tip-0171",
      "category": "积累与复利",
      "text": "你以为忘了的，其实还在脑子里等你。"
    },
    {
      "id": "tip-0172",
      "category": "积累与复利",
      "text": "一点一滴地记，久了就是一片海。"
    },
    {
      "id": "tip-0173",
      "category": "积累与复利",
      "text": "每天的积累看着平常，合起来却惊人。"
    },
    {
      "id": "tip-0174",
      "category": "积累与复利",
      "text": "先把基础垫厚，复杂的东西才站得住。"
    },
    {
      "id": "tip-0175",
      "category": "积累与复利",
      "text": "认识一个词根，就能牵出一串词。"
    },
    {
      "id": "tip-0176",
      "category": "积累与复利",
      "text": "读书的收获，常常在很久以后才到账。"
    },
    {
      "id": "tip-0177",
      "category": "积累与复利",
      "text": "隔几天回头看看，印象会更深。"
    },
    {
      "id": "tip-0178",
      "category": "积累与复利",
      "text": "把零散的时间用起来，收获会自己攒。"
    },
    {
      "id": "tip-0179",
      "category": "积累与复利",
      "text": "记住的词慢慢连成句子，就成了能力。"
    },
    {
      "id": "tip-0180",
      "category": "积累与复利",
      "text": "现在的每一点投入，都在往后生长。"
    },
    {
      "id": "tip-0181",
      "category": "积累与复利",
      "text": "进步不一定看得见，但它确实在发生。"
    },
    {
      "id": "tip-0182",
      "category": "积累与复利",
      "text": "今天多懂一个句子，明天就少一分陌生。"
    },
    {
      "id": "tip-0183",
      "category": "积累与复利",
      "text": "多次重复之后，陌生会变成熟悉。"
    },
    {
      "id": "tip-0184",
      "category": "积累与复利",
      "text": "把每天的小收获记下来，回头看会很厚。"
    },
    {
      "id": "tip-0185",
      "category": "积累与复利",
      "text": "与其求快，不如求每天都有留下。"
    },
    {
      "id": "tip-0186",
      "category": "积累与复利",
      "text": "单词像砖，一块块垒起来才有墙。"
    },
    {
      "id": "tip-0187",
      "category": "积累与复利",
      "text": "长期做一件事，时间会替你完成它。"
    },
    {
      "id": "tip-0188",
      "category": "积累与复利",
      "text": "每一点积累都真实存在，只是暂时安静。"
    },
    {
      "id": "tip-0189",
      "category": "积累与复利",
      "text": "把今天学会的词，讲给明天的自己听。"
    },
    {
      "id": "tip-0190",
      "category": "积累与复利",
      "text": "读懂一篇短文，成就感会自己长出来。"
    },
    {
      "id": "tip-0191",
      "category": "积累与复利",
      "text": "量变到质变，中间需要一点耐心。"
    },
    {
      "id": "tip-0192",
      "category": "积累与复利",
      "text": "每天比昨天多会一点，就是复利。"
    },
    {
      "id": "tip-0193",
      "category": "积累与复利",
      "text": "把学到的用出去，记忆会更牢一些。"
    },
    {
      "id": "tip-0194",
      "category": "积累与复利",
      "text": "一点一点加起来的厚度，最靠得住。"
    },
    {
      "id": "tip-0195",
      "category": "积累与复利",
      "text": "不用急着开花，根先扎稳就好。"
    },
    {
      "id": "tip-0196",
      "category": "积累与复利",
      "text": "慢慢来，但每回都留下一点东西。"
    },
    {
      "id": "tip-0197",
      "category": "积累与复利",
      "text": "今天的复习，是明天的省力。"
    },
    {
      "id": "tip-0198",
      "category": "积累与复利",
      "text": "攒下的词句，会变成你自己的声音。"
    },
    {
      "id": "tip-0199",
      "category": "积累与复利",
      "text": "你正在长成能读懂更多东西的人。"
    },
    {
      "id": "tip-0200",
      "category": "积累与复利",
      "text": "一分钟一分钟地累积起来，就很可观。"
    },
    {
      "id": "tip-0201",
      "category": "面对困难",
      "text": "记不住单词时，先别急着责怪自己。"
    },
    {
      "id": "tip-0202",
      "category": "面对困难",
      "text": "每个人都有学不进去的那几天，它会过去的。"
    },
    {
      "id": "tip-0203",
      "category": "面对困难",
      "text": "记不住的词，换个时间再见就熟了。"
    },
    {
      "id": "tip-0204",
      "category": "面对困难",
      "text": "碰到瓶颈期不是你退步，只是在积蓄。"
    },
    {
      "id": "tip-0205",
      "category": "面对困难",
      "text": "一个词背了七遍还是混，那就再来一遍。"
    },
    {
      "id": "tip-0206",
      "category": "面对困难",
      "text": "容易混的词记不牢，就把它放进句子里。"
    },
    {
      "id": "tip-0207",
      "category": "面对困难",
      "text": "今天状态不好，就只背十个，也算数。"
    },
    {
      "id": "tip-0208",
      "category": "面对困难",
      "text": "忘得快不代表白学，只是还没到熟练的时候。"
    },
    {
      "id": "tip-0209",
      "category": "面对困难",
      "text": "背不下去时，把书合上，喝口水再回来。"
    },
    {
      "id": "tip-0210",
      "category": "面对困难",
      "text": "进步慢不是停止，只是它的步子比较小。"
    },
    {
      "id": "tip-0211",
      "category": "面对困难",
      "text": "卡住的地方，往往正是要慢慢弄懂的地方。"
    },
    {
      "id": "tip-0212",
      "category": "面对困难",
      "text": "遇到难关时，先深呼吸，再想想下一步能做什么。"
    },
    {
      "id": "tip-0213",
      "category": "面对困难",
      "text": "今天背不下的词，过几天可能就顺口了。"
    },
    {
      "id": "tip-0214",
      "category": "面对困难",
      "text": "感到吃力，说明你正在走上坡路，别急着泄气。"
    },
    {
      "id": "tip-0215",
      "category": "面对困难",
      "text": "转不过弯的时候，可以先绕开，回头再来处理。"
    },
    {
      "id": "tip-0216",
      "category": "面对困难",
      "text": "难题不会一直挡在那里，它会随着你的积累变小。"
    },
    {
      "id": "tip-0217",
      "category": "面对困难",
      "text": "真正让人进步的，常常是那些不太顺的日子。"
    },
    {
      "id": "tip-0218",
      "category": "面对困难",
      "text": "单词记混了，就把它和相近的那个摆在一起看。"
    },
    {
      "id": "tip-0219",
      "category": "面对困难",
      "text": "一遍没懂，就再来一遍，这没有什么不好意思的。"
    },
    {
      "id": "tip-0220",
      "category": "面对困难",
      "text": "眼前的困难，放在一整年里看，其实没那么重。"
    },
    {
      "id": "tip-0221",
      "category": "面对困难",
      "text": "累了就先把书本合上，明天照样能接着来。"
    },
    {
      "id": "tip-0222",
      "category": "面对困难",
      "text": "慢慢来不是放弃，是给自己留出消化的时间。"
    },
    {
      "id": "tip-0223",
      "category": "面对困难",
      "text": "遇到读不懂的长句，先拆开，再一段段理解。"
    },
    {
      "id": "tip-0224",
      "category": "面对困难",
      "text": "走得慢的人，只要方向没错，也能到达终点。"
    },
    {
      "id": "tip-0225",
      "category": "面对困难",
      "text": "困难的形状会变，你的办法也会越来越多。"
    },
    {
      "id": "tip-0226",
      "category": "面对困难",
      "text": "今天只解决一个小问题，也算认真地向前走了。"
    },
    {
      "id": "tip-0227",
      "category": "面对困难",
      "text": "记不住的时候，换种方式，比如读出来或写下来。"
    },
    {
      "id": "tip-0228",
      "category": "面对困难",
      "text": "心里堵得慌时，去走一走，回来再看这道题。"
    },
    {
      "id": "tip-0229",
      "category": "面对困难",
      "text": "每跨过一道坎，你手里的底气就多一分。"
    },
    {
      "id": "tip-0230",
      "category": "面对困难",
      "text": "错得多了，反而更容易看清自己漏在哪里。"
    },
    {
      "id": "tip-0231",
      "category": "面对困难",
      "text": "慢慢磨出来的本事，才不会轻易丢掉。"
    },
    {
      "id": "tip-0232",
      "category": "面对困难",
      "text": "面对堆积的任务，先挑最容易的那件开始。"
    },
    {
      "id": "tip-0233",
      "category": "面对困难",
      "text": "今天状态不好，就少做一点，不用跟自己较劲。"
    },
    {
      "id": "tip-0234",
      "category": "面对困难",
      "text": "有些答案要等一等才会出现，急也急不来。"
    },
    {
      "id": "tip-0235",
      "category": "面对困难",
      "text": "一个词反复见面，总有一天会变成老朋友。"
    },
    {
      "id": "tip-0236",
      "category": "面对困难",
      "text": "难题像一堵墙，绕一绕，也能找到门。"
    },
    {
      "id": "tip-0237",
      "category": "面对困难",
      "text": "心里没底的时候，就去做那件最确定的小事。"
    },
    {
      "id": "tip-0238",
      "category": "面对困难",
      "text": "停顿不等于停下，你只是在换口气。"
    },
    {
      "id": "tip-0239",
      "category": "面对困难",
      "text": "那些绕不过去的坎，最后都成了你的经验。"
    },
    {
      "id": "tip-0240",
      "category": "面对困难",
      "text": "每天能多懂一点，难道不值得开心吗？"
    },
    {
      "id": "tip-0241",
      "category": "面对困难",
      "text": "我们都会有状态不好的日子，慢慢调整就行。"
    },
    {
      "id": "tip-0242",
      "category": "面对困难",
      "text": "把大目标切成小块，看起来就没那么吓人。"
    },
    {
      "id": "tip-0243",
      "category": "面对困难",
      "text": "你觉得难，是因为你正在学新的东西。"
    },
    {
      "id": "tip-0244",
      "category": "面对困难",
      "text": "一句没读懂，就再读一遍，理解会慢慢浮上来。"
    },
    {
      "id": "tip-0245",
      "category": "面对困难",
      "text": "心情不好时，先把手边这一页看完。"
    },
    {
      "id": "tip-0246",
      "category": "面对困难",
      "text": "困难挡得住脚步，挡不住你重新出发的心。"
    },
    {
      "id": "tip-0247",
      "category": "面对困难",
      "text": "那些让你头疼的语法，多碰几次就顺了。"
    },
    {
      "id": "tip-0248",
      "category": "面对困难",
